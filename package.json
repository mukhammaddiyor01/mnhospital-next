{
	"name": "mnhospital-next",
	"version": "0.1.0",
	"private": true,
	"workspaces": ["apps/mobile", "apps/web", "packages/*"],
	"engines": { "node": ">=22.13.0" },
	"scripts": {
		"mobile:start": "npm run start --workspace @mnhospital/mobile",
		"mobile:typecheck": "npm run typecheck --workspace @mnhospital/mobile",
		"web:typecheck": "npm run typecheck --workspace @mnhospital/web",
		"test:web:standalone": "node scripts/verify-web-standalone.cjs",
		"test:mobile:a11y": "node scripts/verify-mobile-accessibility.cjs",
		"test:mobile:localization": "node scripts/verify-mobile-localization.cjs",
		"test:mobile:services": "node scripts/verify-mobile-service-pagination.cjs",
		"test:mobile:services:refresh": "node scripts/verify-mobile-service-refresh.cjs",
		"test:mobile:services:response": "node scripts/verify-mobile-service-response.cjs",
		"test:mobile:services:timeout": "node scripts/verify-mobile-service-timeout.cjs",
		"dev": "npm run dev --workspace @mnhospital/web",
		"build": "npm run build --workspace @mnhospital/web",
		"start": "npm run start --workspace @mnhospital/web",
		"lint": "npm run lint --workspace @mnhospital/web",
		"test:auth": "node scripts/verify-auth-session.cjs && node scripts/verify-tab-ownership.cjs",
		"test:profile": "node scripts/verify-profile-completion.cjs",
		"test:seo": "node scripts/verify-seo.cjs",
		"test:seo:http": "node scripts/verify-seo-http.cjs"
	},
	"overrides": {
		"minimatch": "11.0.1",
		"postcss": "8.5.30",
		"source-map-js": "1.2.2"
	}
}
