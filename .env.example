# Every variable in this frontend template is compiled into the browser bundle.
# Never add passwords, database URLs, private keys, or OAuth client secrets here.
NEXT_PUBLIC_API_URL=http://localhost:2001
NEXT_PUBLIC_API_GRAPHQL_URL=http://localhost:2001/graphql
NEXT_PUBLIC_API_WS=ws://localhost:2001/graphql

# Public OAuth application identifiers only. Provider secrets belong in the API `.env`.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_NAVER_CLIENT_ID=
NEXT_PUBLIC_KAKAO_REST_API_KEY=

# Public MN Hospital social profile URLs for footer icons.
NEXT_PUBLIC_MN_INSTAGRAM_URL=
NEXT_PUBLIC_MN_TELEGRAM_URL=
NEXT_PUBLIC_MN_KAKAOTALK_URL=

# Sandbox test payments only; production SDK URLs are blocked. No credentials belong here.
NEXT_PUBLIC_EXIMBAY_SDK_URL=https://api-test.eximbay.com/v3/javascriptSDK.js
