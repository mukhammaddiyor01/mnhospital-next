# Public browser settings. Never put provider secrets or database credentials here.
NEXT_PUBLIC_API_URL=http://localhost:2001
NEXT_PUBLIC_API_GRAPHQL_URL=http://localhost:2001/graphql
NEXT_PUBLIC_SITE_URL=https://mnhospital.uz
# Optional server-side catalog endpoint for sitemap and social previews.
SEO_API_GRAPHQL_URL=
NEXT_PUBLIC_CLINIC_TIME_ZONE=Asia/Seoul
NEXT_PUBLIC_CLINIC_CURRENCY=KRW
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_NAVER_CLIENT_ID=
NEXT_PUBLIC_KAKAO_REST_API_KEY=
# Optional verified business contact; blank keeps the published placeholder hidden.
NEXT_PUBLIC_CLINIC_PHONE=
# Official public social profiles. Set full HTTPS URLs; leave blank until the account exists.
NEXT_PUBLIC_MN_INSTAGRAM_URL=
NEXT_PUBLIC_MN_TELEGRAM_URL=
NEXT_PUBLIC_MN_KAKAOTALK_URL=
# HTTPS reverse proxy: replace with a domain you control, pointing to this server.
MN_DOMAIN=
MN_RELEASE_SHA=
