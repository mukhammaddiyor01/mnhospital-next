{$MN_DOMAIN} {
  encode zstd gzip
  header Strict-Transport-Security "max-age=31536000"
  handle /graphql {
    reverse_proxy host.docker.internal:2001
  }
  handle_path /backend/* {
    reverse_proxy host.docker.internal:2001
  }
  @websocket {
    header Connection *Upgrade*
    header Upgrade websocket
  }
  handle @websocket {
    reverse_proxy host.docker.internal:2001
  }
  handle {
    reverse_proxy host.docker.internal:2002
  }
}
